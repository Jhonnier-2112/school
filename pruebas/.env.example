# Servidor
PORT=8080
ENV=development
BASE_URL=http://localhost:8080

# ===================================================================
# BASE DE DATOS: MySQL (Hostinger)
# ===================================================================
DB_DRIVER=mysql
DB_DSN=usuario:contraseña@tcp(servidor_hostinger:3306)/nombre_base_datos?charset=utf8mb4&parseTime=True&loc=Local

# Base de datos alternativas:
# SQLite (Local):
# DB_DRIVER=sqlite
# DB_DSN=icfes_local.db

# PostgreSQL:
# DB_DRIVER=postgres
# DB_DSN=host=localhost user=postgres password=postgres dbname=icfes_db port=5432 sslmode=disable TimeZone=America/Bogota

# Seguridad JWT
JWT_SECRET=super-secret-jwt-key-for-icfes-platform-2026
JWT_EXPIRATION_HOURS=72

# Almacenamiento de archivos (Cédulas y fotos de preguntas)
UPLOAD_DIR=./uploads

# Credenciales iniciales del Administrador (Semillero automático)
INITIAL_ADMIN_EMAIL=admin@icfes.com
INITIAL_ADMIN_PASSWORD=Admin123456!

# Configuración del Curso Base
COURSE_PRICE=700000
